# Agent Studio — example environment file.
#
# IMPORTANT: API keys do NOT belong here.
# Keys live in the OS keychain only (PROJECT_BRIEF.md §9.2) and are entered
# through the app's onboarding screen. There is no env var for them, by design.
#
# Copy to `.env` only if you need to override a default below.
# `.env` is gitignored and must never contain a provider key.

# Where the SQLite database lives. Unset => ./.data/agent-studio.db in dev.
# AGENT_STUDIO_DATA_DIR=

# Backend bind port. Unset => an ephemeral port chosen by scripts/dev.mjs.
# AGENT_STUDIO_PORT=

# Log level for the backend: debug | info | warning | error
# AGENT_STUDIO_LOG_LEVEL=info
