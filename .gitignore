# --- secrets: never commit ---
.env
*.key
*.pem

# --- local data ---
.data/
*.db
*.db-wal
*.db-shm

# --- python ---
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/

# --- node ---
node_modules/
dist/
.vite/

# --- rust / tauri ---
target/
src-tauri/target/
src-tauri/gen/
# NOTE: src-tauri/icons/* is committed on purpose. tauri-build requires
# icon.ico on Windows and icon.icns on macOS at compile time, so ignoring
# them would make a fresh clone fail to build until someone re-ran
# `npx tauri icon`.

# --- os / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
